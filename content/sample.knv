(defstruct rogue
  :name str
  :tricks (vec str))

(defn scheme (rogue)
  (let (trick (at (:tricks rogue) 0))
    (str (:name rogue) " runs a racket with guile and " trick)))

(defn main ()
  (let (tricks (vec "marked cards" "loaded dice")
        knave (->rogue :name "Knave" :tricks tricks))
    (println (scheme knave))))
