(use strings ends-with? join)

(export ->page canonical-url followed-by llms-links
        markdown-path page sitemap-entries)

(defstruct page
  :path string
  :title string
  :description string
  :content string
  :markdown string)

(def followed-by
  (rust "{0}.into_iter().chain({1}).collect::<Vec<_>>()"
    (fn ((vec page) (vec page)) (vec page))))

(def site-origin "https://knave-lang.org")

(def markdown-extension ".md")

(def directory-markdown-name "index.html.md")

(defn canonical-url (path) (str site-origin path))

(defn markdown-path (path)
  (if (ends-with? path "/")
    (str path directory-markdown-name)
    (str path markdown-extension)))

(defn sitemap-entries (pages)
  (join-lines (map (iter pages) sitemap-entry)))

(type sitemap-entry
  (fn ((ref page)) string))

(defn sitemap-entry (page)
  (str "  <url><loc>"
       (canonical-url (as-str (:path page)))
       "</loc></url>"))

(defn llms-links (pages)
  (join-lines (map (iter pages) llms-link)))

(type llms-link
  (fn ((ref page)) string))

(defn llms-link (page)
  (str "- ["
       (:title page)
       "]("
       (canonical-url (as-str (:path page)))
       "): "
       (:description page)))

(defn join-lines (lines)
  (join (ref (collect lines)) "\n"))
