(use strings join)

(export ->page canonical-url followed-by llms-links page
        sitemap-entries)

(defstruct page
  :path string
  :title string
  :description string
  :content string)

(def followed-by
  (rust "{0}.into_iter().chain({1}).collect::<Vec<_>>()"
    (fn ((vec page) (vec page)) (vec page))))

(def site-origin "https://knave-lang.org")

(defn canonical-url (path) (str site-origin path))

(defn sitemap-entries (pages)
  (join-lines (map (iter pages) sitemap-entry)))

(type sitemap-entry
  (fn ((ref page)) string))

(defn sitemap-entry (page)
  (str "  <url><loc>"
       (canonical-url (as-str (:path page)))
       "</loc></url>"))

(defn llms-links (pages)
  (join-lines (map (iter pages) llms-link)))

(type llms-link
  (fn ((ref page)) string))

(defn llms-link (page)
  (str "- ["
       (:title page)
       "]("
       (canonical-url (as-str (:path page)))
       "): "
       (:description page)))

(defn join-lines (lines)
  (join (ref (collect lines)) "\n"))
