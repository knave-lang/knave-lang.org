(use discovery ->page followed-by page)
(use files files-under path-in read-file)
(use prose prose)
(use markdown-links closing-paren rewrite-link-targets)

(use strings after before contains? ends-with? find-from
             join owned replace-all starts-with?)

(export docs-pages site-markdown summary)

(def generated-directory "target/prelude-docs")

(def docs-path "/docs/")

(def same-page "")

(def markdown-extension ".md")

(def paragraph-break "\n\n")

(def anchor-opening "<a id=\"")

(def heading-marker "#")

(def parent-segment "..")

(def index-title "Knave documentation")

(def index-description
  "Reference pages for the modules of the Knave prelude, generated from the compiler's docstrings.")

(def write-prelude-docs
  (rust "std::process::Command::new(\"knave\").args([\"doc\", \"--write\", \"--prelude\", \"--output\", {0}]).status().and_then(|status| status.success().then_some(()).ok_or_else(|| std::io::Error::other(format!(\"knave doc --write --prelude {{status}}\"))))"
    (fn ((ref str)) (result unit io-error))))

(def directory-of
  (rust "{0}.rfind('/').map_or(\"\", |slash| &{0}[..=slash])"
    (fn ((ref str)) (ref str))))

(defn docs-pages ()
  (try (write-prelude-docs generated-directory))
  (let (sources (try (markdown-sources))
        module-pages (try (module-pages (ref sources) 0 (vec))))
    (ok (with-index-first module-pages))))

(defn markdown-sources ()
  (let (paths (try (files-under generated-directory))
        sources (collect (map (filter (iter paths) markdown-file?) owned-path)))
    (sort! sources)
    (ok sources)))

(defn owned-path (path)
  (owned (as-str path)))

(defn markdown-file? (path)
  (ends-with? (as-str path) markdown-extension))

(type module-pages
  (fn ((ref (vec string)) usize (vec page))
    (result (vec page) io-error)))

(defn module-pages (sources position pages)
  (if (>= position (len sources))
    (ok pages)
    (do
      (push! pages
             (try (module-page (as-str (at sources position)))))
      (recur sources (+ position 1) pages))))

(defn module-page (source)
  (let (markdown (try (read-file (as-str (path-in generated-directory source))))
        module (before source markdown-extension)
        path (module-path module)
        page-markdown (site-markdown (as-str markdown) source same-page)
        copy-markdown (site-markdown (as-str markdown) source (as-str path)))
    (ok (->page path
                (str module " | Knave docs")
                (summary (as-str markdown))
                (prose (as-str page-markdown))
                copy-markdown))))

(defn module-path (module) (str docs-path module "/"))

(defn summary (markdown)
  (let (paragraph (first-paragraph markdown))
    (if (missing-docstring? paragraph)
      (str "")
      (plain-text paragraph))))

(type first-paragraph
  (fn ((ref str)) (ref str)))

(defn first-paragraph (markdown)
  (before (after-title markdown) paragraph-break))

(defn missing-docstring? (paragraph)
  (or (starts-with? paragraph anchor-opening)
      (starts-with? paragraph heading-marker)))

(type after-title
  (fn ((ref str)) (ref str)))

(defn after-title (markdown)
  (match (find-from markdown paragraph-break 0)
    (none "")
    ((some title-end)
     (after markdown (+ title-end (len paragraph-break))))))

(defn plain-text (markdown)
  (-> (without-link-targets markdown 0 (str ""))
      (as-str)
      (replace-all "[" "")
      (as-str)
      (replace-all "`" "")
      (as-str)
      (trim)
      (replace-all "\n" " ")))

(defn without-link-targets (text start plain)
  (match (find-from text "](" start)
    (none (str plain (after text start)))
    ((some label-end)
     (recur text
            (link-end text label-end)
            (str plain (subs text start label-end))))))

(defn link-end (text label-end)
  (min (+ (closing-paren text label-end) 1)
       (len text)))

(defn site-markdown (markdown source same-page-prefix)
  (rewrite-link-targets markdown
    (fn (target) (site-target target source same-page-prefix))))

(defn site-target (target source same-page-prefix)
  (cond
    ((starts-with? target "#") (str same-page-prefix target))
    ((markdown-link? target)
     (str (linked-module-path target (directory-of source))
          (fragment target)))
    (else (owned target))))

(defn linked-module-path (href directory)
  (let (relative-module (str directory (before href markdown-extension))
        module (resolved-path (as-str relative-module)))
    (module-path (as-str module))))

(defn markdown-link? (href)
  (and (not (starts-with? href "#"))
       (not (contains? href "://"))
       (contains? href markdown-extension)))

(defn fragment (href)
  (match (find-from href "#" 0)
    (none "")
    ((some hash) (after href hash))))

(defn resolved-path (path)
  (let (segments (vec))
    (for-each (split path "/")
      (fn (segment)
        (if (= segment parent-segment)
          (do (pop! segments) (do))
          (push! segments (owned segment)))))
    (join (ref segments) "/")))

(defn with-index-first (module-pages)
  (followed-by (vec (index-page (ref module-pages)))
               module-pages))

(defn index-page (module-pages)
  (let (markdown (index-markdown module-pages))
    (->page (owned docs-path)
            (owned index-title)
            (owned index-description)
            (prose (as-str markdown))
            markdown)))

(defn index-markdown (module-pages)
  (str "# Documentation\n\n" index-description "\n\n"
       (join (ref (collect (map (iter module-pages) index-entry)))
             "\n")))

(type index-entry
  (fn ((ref page)) string))

(defn index-entry (module-page)
  (str "- [`"
       (module-name (as-str (:path module-page)))
       "`]("
       (:path module-page)
       "): "
       (:description module-page)))

(defn module-name (path)
  (let (module-with-slash (after path (len docs-path)))
    (subs module-with-slash 0 (- (len module-with-slash) 1))))
