(use markdown/blocks block parse-blocks)
(use markdown/html render-blocks)
(use strings escape-html join owned replace-all slug)
(use template fill)

(export build-doc-pages doc-page)

(defstruct section
  :title string
  :slug string
  :start usize
  :end usize)

(defstruct anchor
  :id string
  :href string)

(defstruct doc-page
  :path string
  :title string
  :body string)

(def overview-title "Overview")

(def repository-blob-url
  "https://github.com/knave-lang/knave/blob/")

(def section-heading-level 2)

(def blocks-between
  (rust "&{0}[{1}..{2}]"
    (fn ((ref (slice block)) usize usize)
      (ref (slice block)))))

(type build-doc-pages
  (fn ((ref str) (ref str) (ref str))
    (vec doc-page)))

(defn build-doc-pages (source revision template)
  (local linked (with-repository-links source revision))
  (local blocks
    (parse-blocks (as-str (with-page-anchors (as-str linked)))))
  (local sections (sections-of (ref blocks)))
  (collect (map (range 0 (len sections))
                (fn (position)
                  (build-page (ref blocks) (ref sections) position template)))))

(defn with-repository-links (source revision)
  (replace-all source "](../"
               (as-str (str "](" repository-blob-url revision "/"))))

(defn with-page-anchors (source)
  (local blocks (parse-blocks source))
  (local anchors
    (collect-anchors (ref blocks)
                     0
                     (str "")
                     (vec)))
  (apply-anchors (owned source) (ref anchors) 0))

(type collect-anchors
  (fn ((ref (vec block))
       usize string
       (vec anchor))
    (vec anchor)))

(defn collect-anchors (blocks index page-slug anchors)
  (if (>= index (len blocks))
    anchors
    (match (at blocks index)
      ((heading level text)
       (local current-page
         (if (= level section-heading-level)
           (slug (as-str text))
           page-slug))
       (if (>= level section-heading-level)
         (push! anchors
                (anchor-to (as-str current-page) (as-str text)))
         (do))
       (recur blocks (+ index 1) current-page anchors))
      (_ (recur blocks (+ index 1) page-slug anchors)))))

(defn anchor-to (page-slug heading-text)
  (local id (slug heading-text))
  (local href (str "/docs/" page-slug "/#" id))
  (->anchor id href))

(type apply-anchors
  (fn (string (ref (slice anchor)) usize)
    string))

(defn apply-anchors (source anchors position)
  (if (>= position (len anchors))
    source
    (let (current (at anchors position))
      (recur (replace-all (as-str source)
                          (as-str (str "](#" (:id current) ")"))
                          (as-str (str "](" (:href current) ")")))
             anchors
             (+ position 1)))))

(type sections-of
  (fn ((ref (vec block))) (vec section)))

(defn sections-of (blocks)
  (local boundaries (section-boundaries blocks 0 (vec 0)))
  (collect (map (range 0 (- (len boundaries) 1))
                (fn (position)
                  (section-at blocks (ref boundaries) position)))))

(type section-boundaries
  (fn ((ref (vec block)) usize (vec usize))
    (vec usize)))

(defn section-boundaries (blocks index boundaries)
  (cond
    ((>= index (len blocks))
     (push! boundaries index)
     boundaries)
    ((and (> index 0)
          (section-heading? (at blocks index)))
     (push! boundaries index)
     (recur blocks (+ index 1) boundaries))
    (else (recur blocks (+ index 1) boundaries))))

(type section-heading?
  (fn ((ref block)) bool))

(defn section-heading? (candidate)
  (match candidate
    ((heading level _) (= level section-heading-level))
    (_ false)))

(type section-at
  (fn ((ref (vec block))
       (ref (vec usize))
       usize)
    section))

(defn section-at (blocks boundaries position)
  (local start (at boundaries position))
  (local end (at boundaries (+ position 1)))
  (if (= position 0)
    (->section (owned overview-title) (str "") start end)
    (let (title (heading-text (at blocks start)))
      (->section (owned (as-str title))
                 (slug (as-str title))
                 start end))))

(type heading-text
  (fn ((ref block)) string))

(defn heading-text (candidate)
  (match candidate
    ((heading _ text) (owned (as-str text)))
    (_ (str ""))))

(type build-page
  (fn ((ref (vec block))
       (ref (vec section))
       usize
       (ref str))
    doc-page))

(defn build-page (blocks sections position template)
  (local current (at sections position))
  (local sidebar (render-sidebar sections position))
  (local pager (render-pager sections position))
  (local article
    (render-blocks (blocks-between blocks (:start current) (:end current))))
  (local with-sidebar
    (fill template "sidebar" (as-str sidebar)))
  (local with-pager
    (fill (as-str with-sidebar) "pager" (as-str pager)))
  (->doc-page (page-path current)
              (owned (as-str (:title current)))
              (fill (as-str with-pager) "article" (as-str article))))

(type page-path
  (fn ((ref section)) string))

(defn page-path (current)
  (if (empty? (:slug current))
    (str "docs")
    (str "docs/" (:slug current))))

(type section-href
  (fn ((ref section)) string))

(defn section-href (current)
  (str "/" (page-path current) "/"))

(type render-sidebar
  (fn ((ref (vec section)) usize) string))

(defn render-sidebar (sections current-position)
  (local links
    (collect (map (range 0 (len sections))
                  (fn (position)
                    (render-sidebar-link (at sections position)
                                         (= position current-position))))))
  (join (ref links) "\n"))

(type render-sidebar-link
  (fn ((ref section) bool) string))

(defn render-sidebar-link (current page?)
  (str "<a href=\""
       (section-href current)
       "\""
       (if page? " aria-current=\"page\"" "")
       ">"
       (escape-html (as-str (:title current)))
       "</a>"))

(type render-pager
  (fn ((ref (vec section)) usize) string))

(defn render-pager (sections position)
  (str (if (> position 0)
         (render-pager-link "Previous" (at sections (- position 1)))
         (str "<span></span>"))
       (if (< (+ position 1) (len sections))
         (render-pager-link "Next" (at sections (+ position 1)))
         (str "<span></span>"))))

(type render-pager-link
  (fn ((ref str) (ref section)) string))

(defn render-pager-link (label target)
  (str "<a href=\""
       (section-href target)
       "\"><small>" label "</small>"
       (escape-html (as-str (:title target)))
       "</a>"))
