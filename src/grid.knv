(use files failure write-file)

(use knave-grid defgrid overlay-css overlay-javascript
                write-grid)

(export write-grid-files)

(defgrid site-grid
         ()
         (fonts :from "static"
                (iosevka "Iosevka"
                         (regular "iosevka-regular.woff2")
                         (bold "iosevka-bold.woff2")))
         (body iosevka :size 18 :line-height 1.5)
         (type-areas (narrow :width 19 :column-count 2)
                     (medium :width 35 :column-count 4)
                     (wide :width 47
                           :column-count 4
                           :margin 2
                           :foot 3
                           :measure-columns (some 2)))
         (type-styles (wordmark :lines 4) (title :lines 2)))

(defn write-grid-files (directory)
  (match (site-grid)
    ((err error) (err (failure (str "grid: " error))))
    ((ok grid)
     (for-each (iter (:warnings grid))
       (fn (warning) (eprintln "warning: grid: " warning)))
     (try (map-err (write-grid (ref grid)
                               (as-str (str directory "/grid.css")))
                   (fn (error)
                     (failure (str "grid: " error)))))
     (try (write-file (as-str (str directory "/grid-overlay.css"))
                      overlay-css))
     (write-file (as-str (str directory "/grid-overlay.js"))
                 overlay-javascript))))
