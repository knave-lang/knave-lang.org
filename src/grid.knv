(use files failure write-file)

(use knave-grid defgrid overlay-css overlay-javascript
                write-grid)

(export write-grid-files)

(defgrid site-grid ()
  (fonts :from "static"
         (iosevka "Iosevka"
                  (regular "iosevka-regular.woff2")
                  (bold "iosevka-bold.woff2")))
  (body iosevka :size 18 :line-height 1.5)
  (type-areas (narrow :width 19 :column-count 1 :head 2 :field-lines 4)
              (medium :width 35 :column-count 4 :head 2 :field-lines 4)
              (wide :width 47
                    :column-count 4
                    :head 2
                    :margin 2
                    :foot 3
                    :measure-columns 2
                    :field-lines 4))
  (type-styles (wordmark :lines 4 :size 128) (title :lines 2)))

(defn write-grid-files (directory)
  (try (map-err (write-checked-grid directory) grid-failure))
  (try (write-file (as-str (str directory "/grid-overlay.css"))
                   overlay-css))
  (write-file (as-str (str directory "/grid-overlay.js"))
              overlay-javascript))

(defn write-checked-grid (directory)
  (let (grid (try (site-grid)))
    (report-warnings grid)
    (write-grid grid (as-str (str directory "/grid.css")))))

(defn report-warnings (grid)
  (for-each (iter (:warnings grid))
    (fn (warning) (eprintln "warning: grid: " warning))))

(defn grid-failure (error)
  (failure (str "grid: " error)))
