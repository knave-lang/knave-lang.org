(use strings after before contains? ends-with? find-from
             owned starts-with?)

(export ->site-files ->site-page broken-links index-of)

(defstruct site-page
  :file string
  :html string)

(defstruct site-files
  :paths (vec string)
  :pages (vec site-page))

(def href-marker " href=\"")

(def index-file "index.html")

(defn broken-links (site)
  (let (broken (vec))
    (for-each (iter (:pages site))
      (fn (page)
        (collect-broken-links! site page (mut broken))))
    broken))

(defn collect-broken-links! (site page broken)
  (for-each (iter (hrefs-in (as-str (:html page)) 0 (vec)))
    (fn (href)
      (if (broken-link? site page (as-str href))
        (push! broken (str (:file page) ": " href))
        (do)))))

(defn hrefs-in (html start hrefs)
  (match (find-from html href-marker start)
    (none hrefs)
    ((some marker)
     (let (value-start (+ marker (len href-marker)))
       (match (find-from html "\"" value-start)
         (none hrefs)
         ((some value-end)
          (push! hrefs (owned (subs html value-start value-end)))
          (recur html value-end hrefs)))))))

(defn broken-link? (site page href)
  (cond
    ((external? href) false)
    ((rooted? href) (not (resolves? site page href)))
    (else true)))

(defn external? (href)
  (or (contains? href "://") (starts-with? href "mailto:")))

(defn rooted? (href)
  (or (starts-with? href "/") (starts-with? href "#")))

(defn resolves? (site page href)
  (match (find-from href "#" 0)
    (none (file-listed? site (as-str (target-file site page href))))
    ((some hash)
     (let (target (target-file site page (subs href 0 hash)))
       (holds-id? site target (after href (+ hash 1)))))))

(defn target-file (site page path)
  (if (empty? path)
    (owned (as-str (:file page)))
    (listed-or-index site (after (before path "?") 1))))

(defn listed-or-index (site relative)
  (if (file-listed? site relative)
    (owned relative)
    (index-of relative)))

(defn index-of (directory)
  (if (or (empty? directory) (ends-with? directory "/"))
    (str directory index-file)
    (str directory "/" index-file)))

(defn file-listed? (site target)
  (any? (iter (:paths site))
    (fn (path) (= (as-str path) target))))

(defn holds-id? (site target id)
  (let (id-attribute (str " id=\"" id "\""))
    (any? (iter (:pages site))
      (fn (page)
        (and (= (:file page) target)
             (contains? (as-str (:html page))
                        (as-str id-attribute)))))))
