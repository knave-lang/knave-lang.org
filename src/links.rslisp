(use src/strings after contains? ends-with? find-from owned
                 starts-with?)

(export ->site-files ->site-page broken-links index-of
        site-files site-page)

(defstruct site-page
  :path string
  :html string)

(defstruct site-files
  :paths (vec string)
  :pages (vec site-page))

(def href-marker " href=\"")

(def index-file "index.html")

(type broken-links
  (fn ((ref site-files)) (vec string)))

(defn broken-links (site)
  (local broken (vec))
  (for-each (iter (:pages site))
            (fn (page)
              (collect-broken-links! site page (mut broken))))
  broken)

(type collect-broken-links!
  (fn ((ref site-files)
       (ref site-page)
       (mut (vec string)))
    unit))

(defn collect-broken-links! (site page broken)
  (for-each (iter (hrefs-in (as-str (:html page)) 0 (vec)))
            (fn (href)
              (if (broken-link? site page (as-str href))
                (push! broken (str (:path page) ": " href))
                (do)))))

(type hrefs-in
  (fn ((ref str) usize (vec string))
    (vec string)))

(defn hrefs-in (html start hrefs)
  (match (find-from html href-marker start)
    (none hrefs)
    ((some marker)
     (local value-start (+ marker (len href-marker)))
     (match (find-from html "\"" value-start)
       (none hrefs)
       ((some value-end)
        (push! hrefs (owned (subs html value-start value-end)))
        (recur html value-end hrefs))))))

(type broken-link?
  (fn ((ref site-files)
       (ref site-page)
       (ref str))
    bool))

(defn broken-link? (site page href)
  (and (internal? href)
       (not (resolves? site page href))))

(defn internal? (href)
  (or (starts-with? href "/") (starts-with? href "#")))

(type resolves?
  (fn ((ref site-files)
       (ref site-page)
       (ref str))
    bool))

(defn resolves? (site page href)
  (match (find-from href "#" 0)
    (none (file-listed? site (as-str (target-file site page href))))
    ((some hash)
     (local target (target-file site page (subs href 0 hash)))
     (holds-id? site
                (as-str target)
                (after href (+ hash 1))))))

(type target-file
  (fn ((ref site-files)
       (ref site-page)
       (ref str))
    string))

(defn target-file (site page path)
  (if (empty? path)
    (owned (as-str (:path page)))
    (listed-or-index site (after path 1))))

(type listed-or-index
  (fn ((ref site-files) (ref str)) string))

(defn listed-or-index (site relative)
  (if (file-listed? site relative)
    (owned relative)
    (index-of relative)))

(defn index-of (directory)
  (if (or (empty? directory) (ends-with? directory "/"))
    (str directory index-file)
    (str directory "/" index-file)))

(type file-listed?
  (fn ((ref site-files) (ref str)) bool))

(defn file-listed? (site target)
  (any? (iter (:paths site))
        (fn (path) (= (as-str path) target))))

(type holds-id?
  (fn ((ref site-files) (ref str) (ref str))
    bool))

(defn holds-id? (site target id)
  (local id-attribute (str " id=\"" id "\""))
  (any? (iter (:pages site))
        (fn (page)
          (and (= (as-str (:path page)) target)
               (contains? (as-str (:html page))
                          (as-str id-attribute))))))
