(use strings after find-from leading-count starts-with?)

(export closing-paren link-targets rewrite-link-targets)

(defstruct target-span
  :start usize
  :end usize)

(def link-opening "](")

(def backtick "`")

(def fence-marker "```")

(def closing-fence "\n```")

(defn link-targets (markdown)
  (collect (map (iter (target-spans markdown))
             (fn (span) (span-text markdown span)))))

(defn rewrite-link-targets (markdown rewrite)
  (let (spans (target-spans markdown)
        replacements (collect (map (iter spans)
                                (fn (span)
                                  (rewrite (as-str (span-text markdown
                                                              span)))))))
    (stitch markdown
            (ref spans)
            (ref replacements)
            0 0
            (str ""))))

(type stitch
  (fn ((ref str)
       (ref (vec target-span))
       (ref (vec string))
       usize usize string)
    string))

(defn stitch (markdown spans replacements position start stitched)
  (if (>= position (len spans))
    (str stitched (after markdown start))
    (let (span (at spans position))
      (recur markdown spans replacements
             (+ position 1)
             (:end span)
             (str stitched
                  (subs markdown start (:start span))
                  (at replacements position))))))

(type span-text
  (fn ((ref str) (ref target-span))
    string))

(defn span-text (markdown span)
  (str (subs markdown (:start span) (:end span))))

(defn target-spans (markdown)
  (spans-from markdown 0 (vec)))

(defn spans-from (markdown start spans)
  (let (opening (position-of markdown link-opening start)
        code (position-of markdown backtick start))
    (cond
      ((= opening (len markdown)) spans)
      ((< code opening)
       (recur markdown (after-code markdown code) spans))
      (else (let (target-start (+ opening (len link-opening))
                  target-end (closing-paren markdown target-start))
              (push! spans (->target-span target-start target-end))
              (recur markdown target-end spans))))))

(defn position-of (text pattern start)
  (match (find-from text pattern start)
    (none (len text))
    ((some found) found)))

(defn after-code (markdown code)
  (if (fence-at? markdown code)
    (after-fence markdown code)
    (after-code-span markdown code)))

(defn fence-at? (markdown code)
  (and (starts-with? (after markdown code) fence-marker)
       (line-start? markdown code)))

(defn line-start? (markdown position)
  (or (= position 0)
      (= (subs markdown (- position 1) position) "\n")))

(defn after-fence (markdown fence)
  (let (close (position-of markdown closing-fence
                           (+ fence (len fence-marker))))
    (position-of markdown "\n"
                 (min (+ close 1) (len markdown)))))

(defn after-code-span (markdown code)
  (let (run (leading-count (after markdown code) (char "`"))
        content-start (+ code run)
        delimiter (subs markdown code content-start)
        close (position-of markdown delimiter content-start))
    (if (= close (len markdown))
      content-start
      (+ close run))))

(defn closing-paren (text start)
  (match (find-from text ")" start)
    (none (len text))
    ((some close) close)))
