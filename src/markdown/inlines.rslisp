(use src/strings after escape-html find-from starts-with?)

(export render-inlines)

(defstruct span
  :markup string
  :resume-at usize)

(def next-delimiter
  (rust "{0}[{1}..].find(['`', '*', '[', '\\\\']).map(|offset| offset + {1})"
    (fn ((ref str) usize) (option usize))))

(def backtick-run-length
  (rust "{0}[{1}..].bytes().take_while(|byte| *byte == b'`').count()"
    (fn ((ref str) usize) usize)))

(def backticks
  (rust "\"`\".repeat({0})" (fn (usize) string)))

(def ascii-punctuation-at?
  (rust "{0}.as_bytes().get({1}).is_some_and(u8::is_ascii_punctuation)"
    (fn ((ref str) usize) bool)))

(defn render-inlines (text)
  (render-from text 0 (str "")))

(defn render-from (text start rendered)
  (match (next-delimiter text start)
    (none (str rendered (escape-html (after text start))))
    ((some at)
     (local rendered-span (render-span text at))
     (recur text
            (:resume-at rendered-span)
            (str rendered
                 (escape-html (subs text start at))
                 (:markup rendered-span))))))

(defn render-span (text at)
  (local rest (after text at))
  (cond
    ((starts-with? rest "\\") (render-escape text at))
    ((starts-with? rest "`") (render-code text at))
    ((starts-with? rest "**")
     (render-wrapped text at "**" "strong"))
    ((starts-with? rest "*") (render-emphasis text at))
    (else (render-link text at))))

(defn render-escape (text at)
  (local escaped (+ at 1))
  (if (ascii-punctuation-at? text escaped)
    (->span (escape-html (subs text escaped (+ escaped 1)))
            (+ escaped 1))
    (->span (str "\\") escaped)))

(defn render-code (text at)
  (local run (backtick-run-length text at))
  (local fence (backticks run))
  (local content-start (+ at run))
  (match (find-from text (as-str fence) content-start)
    (none (->span fence content-start))
    ((some close)
     (->span (str "<code>"
                  (escape-html (trim (subs text content-start close)))
                  "</code>")
             (+ close run)))))

(defn render-emphasis (text at)
  (if (starts-with? (after text (+ at 1)) " ")
    (->span (str "*") (+ at 1))
    (render-wrapped text at "*" "em")))

(defn render-wrapped (text at marker tag)
  (local content-start (+ at (len marker)))
  (match (find-from text marker content-start)
    (none (->span (str marker) content-start))
    ((some close)
     (->span (str "<" tag ">"
                  (render-inlines (subs text content-start close))
                  "</" tag ">")
             (+ close (len marker))))))

(defn render-link (text at)
  (local plain-bracket
    (->span (str "[") (+ at 1)))
  (match (find-from text "](" at)
    (none plain-bracket)
    ((some label-end)
     (if (bracket-free? text (+ at 1) label-end)
       (render-link-target text at label-end plain-bracket)
       plain-bracket))))

(defn bracket-free? (text start end)
  (none? (find-from (subs text start end) "]" 0)))

(defn render-link-target (text at label-end plain-bracket)
  (local target-start (+ label-end 2))
  (match (find-from text ")" target-start)
    (none plain-bracket)
    ((some target-end)
     (->span (str "<a href=\""
                  (escape-html (subs text target-start target-end))
                  "\">"
                  (render-inlines (subs text (+ at 1) label-end))
                  "</a>")
             (+ target-end 1)))))
