(use discovery ->page canonical-url followed-by page
               sitemap-entries)

(use files copy-directory-files failure files-under path-in
           read-file remove-directory write-file
           write-index)

(use docs docs-pages)
(use grid write-grid-files)
(use knave-llms-txt markdown-path)
(use llms llms-full-text llms-index)

(use links ->site-files broken-links html-page
           markdown-page)

(use prose prose)
(use samples code-sample fenced)
(use strings ends-with? escape-html fnv1a-digest join owned)
(use template fill)

(export build-site output-directory)

(def output-directory "public")

(def landing-path "/")

(def static-directory "static")

(def landing-title
  "Knave programming language: a Lisp that compiles to Rust")

(def landing-description
  "Knave is a programming language for humans and agents. It is a small Lisp that infers types and ownership and compiles to readable Rust.")

(def landing-pitch
  "Knave infers most types and ownership for you. The Rust it emits is the Rust you would have written, with no clones or allocations you did not ask for.")

(def landing-caution
  "Knave is experimental. The syntax, the prelude and the command line can change in any commit.")

(def install-description
  "Install the Knave programming language with Cargo or Nix, then create and run your first project.")

(def knave-language "knave")

(def rust-language "rust")

(defn build-site ()
  (try (remove-directory output-directory))
  (try (copy-directory-files static-directory output-directory))
  (try (write-grid-files output-directory))
  (let (pages (followed-by (vec (try (landing-page))
                                (try (install-page)))
                           (try (docs-pages)))
        layout (try (layout-with-stylesheet-version)))
    (try (write-pages (as-str layout) (ref pages) 0))
    (try (write-discovery-files (ref pages)))
    (check-links)))

(defn layout-with-stylesheet-version ()
  (let (layout (try (read-file "templates/layout.html"))
        stylesheet-path (str static-directory "/style.css")
        stylesheet (try (read-file (as-str stylesheet-path))))
    (ok (fill (as-str layout)
              "stylesheet-version"
              (as-str (fnv1a-digest (as-str stylesheet)))))))

(type write-pages
  (fn ((ref str) (ref (vec page)) usize)
    (result unit io-error)))

(defn write-pages (layout pages position)
  (if (>= position (len pages))
    (ok (do))
    (let (page (at pages position))
      (try (write-index (as-str (str output-directory (:path page)))
                        (as-str (in-layout layout page))))
      (try (write-markdown-copy page))
      (recur layout pages (+ position 1)))))

(type write-markdown-copy
  (fn ((ref page)) (result unit io-error)))

(defn write-markdown-copy (page)
  (let (copy-path (str output-directory
                       (markdown-path (as-str (:path page)))))
    (write-file (as-str copy-path)
                (as-str (:markdown page)))))

(type in-layout
  (fn ((ref str) (ref page)) string))

(defn in-layout (layout page)
  (-> (fill layout "title"
            (as-str (escape-html (as-str (:title page)))))
      (as-str)
      (fill "description"
            (as-str (escape-html (as-str (:description page)))))
      (as-str)
      (fill "canonical"
            (as-str (canonical-url (as-str (:path page)))))
      (as-str)
      (fill "content" (as-str (:content page)))))

(defn write-discovery-files (pages)
  (try (write-from-template "sitemap.xml" "pages"
                            (as-str (sitemap-entries pages))))
  (try (write-from-template "robots.txt" "sitemap"
                            (as-str (canonical-url "/sitemap.xml"))))
  (try (write-output "llms.txt"
                     (as-str (llms-index landing-caution pages))))
  (write-output "llms-full.txt"
                (as-str (llms-full-text landing-caution pages))))

(defn write-from-template (file-name placeholder value)
  (let (template (try (read-template file-name)))
    (write-output file-name
                  (as-str (fill (as-str template) placeholder value)))))

(defn read-template (file-name)
  (let (template-path (str "templates/" file-name))
    (read-file (as-str template-path))))

(defn write-output (file-name contents)
  (let (output-path (path-in output-directory file-name))
    (write-file (as-str output-path) contents)))

(defn landing-page ()
  (let (template (try (read-file "templates/landing.html"))
        knave-sample (try (read-file "content/sample.knv"))
        rust-sample (try (read-file "content/sample.rs"))
        knave-code (trim (as-str knave-sample))
        rust-code (trim (as-str rust-sample)))
    (ok (->page (owned landing-path)
                (owned landing-title)
                (owned landing-description)
                (landing-html (as-str template) knave-code rust-code)
                (landing-markdown knave-code rust-code)))))

(defn landing-html (template knave-code rust-code)
  (-> (fill template "pitch" (as-str (escape-html landing-pitch)))
      (as-str)
      (fill "caution" (as-str (escape-html landing-caution)))
      (as-str)
      (fill "knave-sample"
            (as-str (code-sample knave-language knave-code)))
      (as-str)
      (fill "rust-sample"
            (as-str (code-sample rust-language rust-code)))))

(defn landing-markdown (knave-code rust-code)
  (str "# " landing-title "\n\n" landing-pitch "\n\n"
       landing-caution "\n\n" "A Knave program:\n\n"
       (fenced knave-language knave-code)
       "\n\n"
       "The Rust that `knave emit main.knv` prints for it:\n\n"
       (fenced rust-language rust-code)
       "\n"))

(defn install-page ()
  (let (source (try (read-file "content/install.md"))
        content (prose (as-str source)))
    (ok (->page (owned "/install/")
                (owned "Install Knave")
                (owned install-description)
                content source))))

(defn check-links ()
  (let (paths (try (files-under output-directory))
        pages (try (read-pages (ref paths) 0 (vec)))
        site (->site-files paths pages)
        broken (broken-links (ref site)))
    (if (empty? broken)
      (ok (do))
      (err (failure (str "broken internal links:\n"
                         (join (ref broken) "\n")))))))

(defn markdown-file? (path)
  (or (ends-with? path ".md")
      (= path "llms.txt")
      (= path "llms-full.txt")))

(defn read-pages (paths position pages)
  (if (>= position (len paths))
    (ok pages)
    (let (path (as-str (at paths position))
          full-path (path-in output-directory path))
      (cond
        ((ends-with? path ".html")
         (push! pages
                (html-page (owned path)
                           (try (read-file (as-str full-path))))))
        ((markdown-file? path)
         (push! pages
                (markdown-page (owned path)
                               (try (read-file (as-str full-path))))))
        (else (do)))
      (recur paths (+ position 1) pages))))
