(export after before contains? ends-with? escape-html
        find-from first-char? fnv1a-digest in-line-spans
        in-prose join leading-count owned percent-decode
        percent-encode replace-all slug starts-with?)

(def fnv1a-digest
  (rust "{0}.bytes().fold(0xcbf29ce484222325_u64, |hash, byte| (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3)).to_string()"
    (fn ((ref str)) string)))

(def starts-with?
  (rust "{0}.starts_with({1})"
    (fn ((ref str) (ref str)) bool)))

(def ends-with?
  (rust "{0}.ends_with({1})"
    (fn ((ref str) (ref str)) bool)))

(def contains?
  (rust "{0}.contains({1})"
    (fn ((ref str) (ref str)) bool)))

(def find-from
  (rust "{0}[{2}..].find({1}).map(|offset| offset + {2})"
    (fn ((ref str) (ref str) usize)
      (option usize))))

(def replace-all
  (rust "{0}.replace({1}, {2})"
    (fn ((ref str) (ref str) (ref str))
      string)))

(def join
  (rust "{0}.join({1})"
    (fn ((ref (slice string)) (ref str))
      string)))

(def chars-to-string
  (rust "{0}.collect::<String>()"
    (fn ((iterator char)) string)))

(def percent-decode
  (rust "{{ let bytes = {0}.as_bytes(); let mut decoded = Vec::new(); let mut index = 0; while index < bytes.len() {{ let escape = bytes.get(index + 1..index + 3).filter(|_| bytes[index] == b'%').and_then(|hex| std::str::from_utf8(hex).ok()).and_then(|hex| u8::from_str_radix(hex, 16).ok()); match escape {{ Some(byte) => {{ decoded.push(byte); index += 3; }} None => {{ decoded.push(bytes[index]); index += 1; }} }} }} String::from_utf8_lossy(&decoded).into_owned() }}"
    (fn ((ref str)) string)))

(def percent-encode
  (rust "{0}.bytes().map(|byte| Some(byte).filter(|kept| kept.is_ascii_alphanumeric() || b\"-._~\".contains(kept)).map_or_else(|| format!(\"%{{:02X}}\", byte), |kept| char::from(kept).to_string())).collect::<String>()"
    (fn ((ref str)) string)))

(defn after (text start)
  (subs text start (len text)))

(type before
  (fn ((ref str) (ref str)) (ref str)))

(defn before (text separator)
  (match (find-from text separator 0)
    (none text)
    ((some found) (subs text 0 found))))

(type owned (fn ((ref str)) string))

(defn owned (text) (str text))

(defn leading-count (text mark)
  (count (take-while (chars text)
           (fn (c) (= c mark)))))

(defn first-char? (text test)
  (any? (take (chars text) 1) test))

(defn slug (text)
  (let (lowered (lower-case text)
        kept (chars-to-string (filter (chars (as-str lowered)) slug-char?)))
    (replace-all (as-str kept) " " "-")))

(defn slug-char? (c)
  (or (alphanumeric? c)
      (= c (char " "))
      (= c (char "-"))))

(defn escape-html (text)
  (-> (replace-all text "&" "&amp;")
      (as-str)
      (replace-all "<" "&lt;")
      (as-str)
      (replace-all ">" "&gt;")
      (as-str)
      (replace-all "\"" "&quot;")))

(defn in-line-spans (text)
  (str "<span class=\"line\">"
       (replace-all text "\n" "\n</span><span class=\"line\">")
       "</span>"))

(defn in-prose (html)
  (str "<main><div class=\"prose\">" html "</div></main>"))
