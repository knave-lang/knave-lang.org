(use files files-under)

(export fingerprint-directories)

(def modified-nanos
  (rust "std::fs::metadata({0}).and_then(|found| found.modified()).map(|modified| modified.duration_since(std::time::UNIX_EPOCH).map_or(0, |elapsed| elapsed.as_nanos()))"
    (fn ((ref str)) (result u128 io-error))))

(defn fingerprint-directories (directories)
  (join-results directories directory-fingerprint 0 (str "")))

(defn directory-fingerprint (directory)
  (let (files (try (files-under directory)))
    (sort! files)
    (join-results (ref files)
                  (fn (file) (file-stamp directory file))
                  0
                  (str ""))))

(defn file-stamp (directory file)
  (let (full-path (str directory "/" file)
        modified (try (modified-nanos (as-str full-path))))
    (ok (str full-path "@" modified "\n"))))

(type join-results
  (fn ((ref (slice string))
       (fn ((ref str))
         (result string io-error))
       usize string)
    (result string io-error)))

(defn join-results (items produce position joined)
  (if (>= position (len items))
    (ok joined)
    (let (produced (try (produce (as-str (at items position)))))
      (recur items produce (+ position 1) (str joined produced)))))
