(use files files-under)

(export directory-fingerprint source-fingerprint)

(def modified-nanos
  (rust "std::fs::metadata({0}).and_then(|found| found.modified()).map(|modified| modified.duration_since(std::time::UNIX_EPOCH).map_or(0, |elapsed| elapsed.as_nanos()))"
    (fn ((ref str)) (result u128 io-error))))

(defn source-fingerprint ()
  (local content (try (directory-fingerprint "content")))
  (local templates (try (directory-fingerprint "templates")))
  (local static-files (try (directory-fingerprint "static")))
  (ok (str content templates static-files)))

(defn directory-fingerprint (directory)
  (local files (try (files-under directory)))
  (sort! files)
  (append-file-stamps directory (ref files) 0 (str "")))

(defn append-file-stamps (directory files position stamps)
  (if (>= position (len files))
    (ok stamps)
    (let (file (as-str (at files position))
          full-path (str directory "/" file)
          modified (try (modified-nanos (as-str full-path))))
      (recur directory files
             (+ position 1)
             (str stamps full-path "@" modified "\n")))))
