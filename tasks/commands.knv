(use knave-preview ->preview serve)
(use site build-site output-directory)

(deftask build ()
  "Builds the site into public/."
  (build-site))

(deftask serve ()
  "Serves the site at http://127.0.0.1:8000 and rebuilds it on change."
  (serve
    (->preview :directory (str output-directory)
               :port 8000
               :watched (vec (str "content")
                             (str "templates")
                             (str "static")))
    build-site))
