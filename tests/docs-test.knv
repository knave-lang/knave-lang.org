(use docs index-markdown site-markdown summary)
(use strings contains?)

(deftest links-a-sibling-module-page-to-its-site-path
  (assert (= (site-markdown "[char](prelude/text.md#char)"
                            "prelude.md" "")
             "[char](/docs/prelude/text/#char)")))

(deftest resolves-a-parent-link-from-a-module-folder
  (assert (= (site-markdown "[>=](../prelude.md#%3E%3D)"
                            "prelude/number.md" "")
             "[>=](/docs/prelude/#%3E%3D)")))

(deftest leaves-a-fragment-on-the-same-page-alone
  (assert (= (site-markdown "[some?](#some%3F)" "prelude/option.md" "")
             "[some?](#some%3F)")))

(deftest roots-a-fragment-at-its-own-page
  (assert (= (site-markdown "[some?](#some%3F)"
                            "prelude/option.md"
                            "/docs/prelude/option/")
             "[some?](/docs/prelude/option/#some%3F)")))

(deftest leaves-an-external-link-alone
  (assert (= (site-markdown "[notes](https://example.com/notes.md)"
                            "prelude.md" "")
             "[notes](https://example.com/notes.md)")))

(deftest leaves-a-link-in-a-code-span-alone
  (assert (= (site-markdown "`[x](y.md)` and [z](y.md)" "prelude.md" "")
             "`[x](y.md)` and [z](/docs/y/)")))

(deftest leaves-a-link-in-a-fence-alone
  (assert (= (site-markdown "```lisp\n[x](y.md)\n```\n[z](y.md)"
                            "prelude.md" "")
             "```lisp\n[x](y.md)\n```\n[z](/docs/y/)")))

(deftest rewrites-a-link-whose-label-is-code
  (assert (= (site-markdown "[`vec`](prelude/vec.md#vec)"
                            "prelude.md" "")
             "[`vec`](/docs/prelude/vec/#vec)")))

(deftest summarizes-a-page-by-its-first-paragraph
  (assert (= (summary "# text\n\nWorks with `str` and\n[char](prelude/text.md#char).\n\n## `len`\n")
             "Works with str and char.")))

(deftest summarizes-a-page-without-a-paragraph-as-empty
  (assert (= (summary "# text\n") "")))

(deftest summarizes-a-module-without-a-docstring-as-empty
  (assert (= (summary "# m\n\n<a id=\"f\"></a>\n\n## `f`\n") "")))

(deftest summarizes-a-re-export-only-module-as-empty
  (assert (= (summary "# m\n\n## Re-exported names\n\n- [`x`](a.md#x)\n")
             "")))

(deftest summarizes-a-page-ending-in-its-paragraph
  (assert (= (summary "# m\n\nOnly line.\n") "Only line.")))

(deftest summarizes-only-the-first-of-several-paragraphs
  (assert (= (summary "# m\n\nFirst.\n\nSecond.\n") "First.")))

(deftest links-the-language-model-guide-from-the-index
  (assert (contains? (as-str (index-markdown (ref (vec))))
                     "](/docs/llms/)")))
