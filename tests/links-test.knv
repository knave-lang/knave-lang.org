(use links ->site-files broken-links html-page
           markdown-page)

(defn page-at (path html)
  (html-page (str path) (str html)))

(defn broken-in (html)
  (let (site (->site-files (vec (str "index.html")
                                (str "docs/index.html")
                                (str "style.css"))
                           (vec (page-at "index.html" html)
                                (page-at "docs/index.html"
                                         "<h2 id=\"types\">Types</h2>"))))
    (broken-links (ref site))))

(deftest accepts-a-link-to-a-directory-index
  (assert (empty? (broken-in "<a href=\"/docs/\">x</a>"))))

(deftest accepts-a-link-to-the-site-root
  (assert (empty? (broken-in "<a href=\"/\">x</a>"))))

(deftest accepts-a-link-to-a-listed-asset
  (assert (empty? (broken-in "<link href=\"/style.css\">"))))

(deftest accepts-a-listed-asset-with-a-query
  (assert (empty? (broken-in "<link href=\"/style.css?v=abc\">"))))

(deftest reports-a-missing-asset-with-a-query
  (assert (= (broken-in "<link href=\"/missing.css?v=abc\">")
             (vec (str "index.html: /missing.css?v=abc")))))

(deftest accepts-a-fragment-that-exists
  (assert (empty? (broken-in "<a href=\"/docs/#types\">x</a>"))))

(deftest accepts-a-fragment-on-the-same-page
  (assert (empty? (broken-in "<h1 id=\"top\"></h1><a href=\"#top\">x</a>"))))

(deftest accepts-a-full-url-to-a-page-on-the-site
  (assert (empty? (broken-in
                    "<a href=\"https://knave-lang.org/docs/\">x</a>"))))

(deftest reports-a-full-url-to-a-missing-page-on-the-site
  (assert (= (broken-in "<a href=\"https://knave-lang.org/missing/\">x</a>")
             (vec (str "index.html: https://knave-lang.org/missing/")))))

(deftest ignores-external-links
  (assert (empty? (broken-in "<a href=\"https://example.com/missing\">x</a>"))))

(deftest reports-a-missing-page
  (assert (= (broken-in "<a href=\"/missing/\">x</a>")
             (vec (str "index.html: /missing/")))))

(deftest reports-a-missing-fragment
  (assert (= (broken-in "<a href=\"/docs/#absent\">x</a>")
             (vec (str "index.html: /docs/#absent")))))

(deftest reports-a-relative-link
  (assert (= (broken-in "<a href=\"missing/\">x</a>")
             (vec (str "index.html: missing/")))))

(deftest accepts-a-percent-encoded-fragment
  (assert (empty? (broken-in
                    "<h2 id=\"some?\"></h2><a href=\"#some%3F\">x</a>"))))

(deftest accepts-a-percent-encoded-operator-fragment
  (assert (empty? (broken-in
                    "<h2 id=\"&gt;=\"></h2><a href=\"#%3E%3D\">x</a>"))))

(deftest reports-a-fragment-that-decodes-to-another-name
  (assert (= (broken-in "<h2 id=\"some\"></h2><a href=\"#some%3F\">x</a>")
             (vec (str "index.html: #some%3F")))))

(deftest reports-a-broken-link-in-a-markdown-copy
  (let (site (->site-files (vec (str "index.html") (str "index.html.md"))
                           (vec (markdown-page (str "index.html.md")
                                               (str "[gone](/missing/)")))))
    (assert (= (broken-links (ref site))
               (vec (str "index.html.md: /missing/"))))))

(deftest accepts-a-markdown-link-to-a-fragment-that-exists
  (let (site (->site-files (vec (str "docs/index.html") (str "index.html.md"))
                           (vec (html-page (str "docs/index.html")
                                           (str "<h2 id=\"some?\"></h2>"))
                                (markdown-page (str "index.html.md")
                                               (str "[x](/docs/#some%3F)")))))
    (assert (empty? (broken-links (ref site))))))
