(use prelude/test assert deftest)
(use src/links ->site-files ->site-page broken-links)

(defn page-at (path html)
  (->site-page (str path) (str html)))

(defn broken-in (html)
  (local site
    (->site-files (vec (str "index.html")
                       (str "docs/index.html")
                       (str "style.css"))
                  (vec (page-at "index.html" html)
                       (page-at "docs/index.html"
                                "<h2 id=\"types\">Types</h2>"))))
  (broken-links (ref site)))

(deftest accepts-a-link-to-a-directory-index
  (assert (empty? (broken-in "<a href=\"/docs/\">x</a>"))))

(deftest accepts-a-link-to-the-site-root
  (assert (empty? (broken-in "<a href=\"/\">x</a>"))))

(deftest accepts-a-link-to-a-listed-asset
  (assert (empty? (broken-in "<link href=\"/style.css\">"))))

(deftest accepts-a-fragment-that-exists
  (assert (empty? (broken-in "<a href=\"/docs/#types\">x</a>"))))

(deftest accepts-a-fragment-on-the-same-page
  (assert (empty? (broken-in "<h1 id=\"top\"></h1><a href=\"#top\">x</a>"))))

(deftest ignores-external-links
  (assert (empty? (broken-in "<a href=\"https://example.com/missing\">x</a>"))))

(deftest reports-a-missing-page
  (assert (= (broken-in "<a href=\"/missing/\">x</a>")
             (vec (str "index.html: /missing/")))))

(deftest reports-a-missing-fragment
  (assert (= (broken-in "<a href=\"/docs/#absent\">x</a>")
             (vec (str "index.html: /docs/#absent")))))

(deftest reports-a-relative-link
  (assert (= (broken-in "<a href=\"missing/\">x</a>")
             (vec (str "index.html: missing/")))))
