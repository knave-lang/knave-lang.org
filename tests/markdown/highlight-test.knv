(use markdown/highlight highlight)

(deftest colors-a-definition
  (assert (= (highlight "(defn add)")
             (as-str (str "<span class=\"paren\">(</span><span class=\"definer\">defn</span> add<span class=\"paren\">)</span>")))))

(deftest colors-a-whole-string-with-an-escaped-quote
  (assert (= (highlight "\"a\\\"b\"")
             "<span class=\"string\">&quot;a\\&quot;b&quot;</span>")))

(deftest colors-a-comment-up-to-the-line-end
  (assert (= (highlight "; note\nx")
             "<span class=\"comment\">; note</span>\nx")))

(deftest colors-keywords-and-numbers
  (assert (= (highlight ":x 42")
             "<span class=\"keyword\">:x</span> <span class=\"number\">42</span>")))

(deftest accepts-non-ascii-words
  (assert (= (highlight "café") "café")))

(deftest keeps-whitespace-before-a-non-ascii-word
  (assert (= (highlight " \t\r\ncafé") " \t\r\ncafé")))
