(use prelude/test assert deftest)
(use markdown/inlines render-inlines)

(deftest escapes-plain-text
  (assert (= (render-inlines "a < b & c") "a &lt; b &amp; c")))

(deftest renders-code-without-inner-markup
  (assert (= (render-inlines "use `*x* <y>` here")
             "use <code>*x* &lt;y&gt;</code> here")))

(deftest renders-double-backtick-code-holding-a-backtick
  (assert (= (render-inlines "`` a`b ``") "<code>a`b</code>")))

(deftest renders-strong-and-emphasis
  (assert (= (render-inlines "**bold** and *soft*")
             "<strong>bold</strong> and <em>soft</em>")))

(deftest renders-links-with-inline-labels
  (assert (= (render-inlines "see [the `doc`](a/b.md).")
             "see <a href=\"a/b.md\">the <code>doc</code></a>.")))

(deftest keeps-a-spaced-asterisk
  (assert (= (render-inlines "2 * 3") "2 * 3")))

(deftest keeps-a-bracket-that-is-no-link
  (assert (= (render-inlines "a [b] then [c](d)")
             "a [b] then <a href=\"d\">c</a>")))

(deftest unescapes-a-backslashed-delimiter
  (assert (= (render-inlines "\\*literal\\*") "*literal*")))

(deftest keeps-a-backslash-before-a-letter
  (assert (= (render-inlines "a\\b") "a\\b")))

(deftest keeps-an-unclosed-backtick-run
  (assert (= (render-inlines "`` a") "`` a")))
