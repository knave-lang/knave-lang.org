(use strings contains?)
(use watch fingerprint-directories)

(defn fingerprint-of (directories)
  (unwrap-ok (fingerprint-directories (ref directories))))

(defn fixtures-fingerprint ()
  (fingerprint-of (vec (str "tests/fixtures"))))

(deftest names-each-file-in-the-fingerprint
  (assert (contains? (as-str (fixtures-fingerprint))
                     "tests/fixtures/sample.md@")))

(deftest repeats-the-fingerprint-for-unchanged-files
  (assert (= (fixtures-fingerprint) (fixtures-fingerprint))))

(deftest names-files-from-every-directory
  (let (fingerprint (fingerprint-of (vec (str "tests/fixtures")
                                         (str "tests/other-fixtures"))))
    (assert (and (contains? (as-str fingerprint) "tests/fixtures/sample.md@")
                 (contains? (as-str fingerprint)
                            "tests/other-fixtures/other.md@")))))
